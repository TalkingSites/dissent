---
pagination:
  data: redirects.items
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyComputed:
  redirectTo: "{{ r.to }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8"/>
<title>Moved to {{ site.canonical }}{{ r.to }}</title>
<meta name="robots" content="noindex"/>
<link rel="canonical" href="{{ site.canonical }}{{ r.to }}"/>
<meta http-equiv="refresh" content="0; url={{ r.to }}"/>
</head>
<body><p>This page has moved to <a href="{{ r.to }}">{{ site.canonical }}{{ r.to }}</a>.</p></body>
</html>
