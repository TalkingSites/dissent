<!doctype html>
<html lang="en-AU" data-bs-theme="{{ 'light' if spaceclubLook.modes == 'both' else spaceclubLook.modes }}">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
{% if spaceclubLook.modes == "both" %}
<script>
// light or dark: the visitor's own choice, else their device's, set before the page draws
(function () {
  var root = document.documentElement, saved;
  try { saved = localStorage.getItem("spaceclub-mode"); } catch (e) {}
  root.setAttribute("data-bs-theme", saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"));
  window.spaceclubToggleMode = function () {
    var next = root.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-bs-theme", next);
    try { localStorage.setItem("spaceclub-mode", next); } catch (e) {}
  };
})();
</script>
{% endif %}
{%- if seoTitle %}{% set pageTitle = seoTitle %}
{%- elif eventDate %}{% set pageTitle = (title | truncate(55, true, "...")) + " live at Dissent, Canberra · " + (eventDate | formatDate("D MMM")) %}
{%- elif postDate %}{% set pageTitle = title + " | Dissent Cafe and Bar" %}
{%- else %}{% set pageTitle = title | default(site.title) %}{% endif %}
{%- set pageUrl = site.canonical + page.url %}
{%- set pageImage = (image if (image and not ("://" in image)) else "/assets/images/preview.jpg") %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description | default(site.description) }}" data-pagefind-meta="description[content]"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
{% if page.url != "/404.html" %}<link rel="canonical" href="{{ pageUrl }}"/>{% else %}<meta name="robots" content="noindex"/>{% endif %}
<meta property="og:title" content="{{ pageTitle }}"/>
<meta property="og:description" content="{{ description | default(site.description) }}"/>
<meta property="og:type" content="{{ 'article' if postDate else 'website' }}"/>
<meta property="og:url" content="{{ pageUrl }}"/>
<meta property="og:site_name" content="{{ site.title }}"/>
<meta property="og:locale" content="en_AU"/>
<meta property="og:image" content="{{ site.canonical }}{{ pageImage }}"/>
<meta name="twitter:card" content="summary_large_image"/>
{% include "partials/schema.njk" %}
<meta name="theme-color" content="#0f0d0c"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400..800&display=swap" rel="stylesheet"/>
<link href="/assets/css/styles.css" rel="stylesheet"/>
{% if spaceclubLookCss %}<style>{{ spaceclubLookCss | safe }}</style>{% endif %}
<link href="/assets/css/dissent.css" rel="stylesheet"/>
<link rel="icon" href="{{ site.favicon }}" type="image/x-icon"/>
{% if spaceclub.features.rss %}{% for feed in spaceclubFeeds %}
<link rel="alternate" type="application/atom+xml" href="{{ feed.url }}" title="{{ site.title }}: {{ feed.title }}"/>
{% endfor %}{% endif %}
{% if site.matomo and site.matomo.url and site.matomo.siteId %}
<!-- Matomo: set by Mission Control when the site is launched -->
<script>
var _paq = window._paq = window._paq || [];
_paq.push(['trackPageView']);
_paq.push(['enableLinkTracking']);
(function() {
var u={{ site.matomo.url | dump | safe }};
_paq.push(['setTrackerUrl', u+'matomo.php']);
_paq.push(['setSiteId', {{ site.matomo.siteId | dump | safe }}]);
var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
})();
</script>
{% endif %}
</head>
<body class="bg-body">
<a class="skip" href="#content">Skip to content</a>
<div>
{% include "partials/navbar.njk" %}
{% if spaceclub.features.search %}<div data-pagefind-body>
<span class="visually-hidden">
{{ title | default(site.title) }}
{{ description |
default(site.description) }}
{% if not description %}
. {{ content |
striptags | replace("\n", " ") | truncate(240, true, "") }}
{% endif %}
</span>
</div>{% endif %}
<main id="content">
{% if "<section" in content %}{{ content | safe }}{% else %}<div class="container py-5 prose">{{ content | safe }}</div>{% endif %}
</main>
</div>
{% include "partials/footer.njk" %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% if spaceclub.features.search %}<script src="/assets/js/search.js" defer></script>{% endif %}
{% if spaceclub.features.webmcp %}<script src="/assets/js/webmcp.js" defer></script>{% endif %}
</body>
</html>