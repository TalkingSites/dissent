<section class="band band-ink find" id="find-us">
<div class="container split">
<div class="rich">
<h2>{{ sectionTitle }}</h2>
<address class="find-address">{{ site.address | replace("\n", "<br/>") | safe }}</address>
{{ sectionText | markdown | safe }}
<ul class="find-links">
<li><a href="{{ site.map }}" rel="noopener"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Directions</a></li>
<li><a href="{{ site.instagram }}" rel="noopener"><i class="bi bi-instagram" aria-hidden="true"></i> Instagram</a></li>
<li><a href="{{ site.facebook }}" rel="noopener"><i class="bi bi-facebook" aria-hidden="true"></i> Facebook</a></li>
<li><a href="mailto:{{ site.email }}"><i class="bi bi-envelope-fill" aria-hidden="true"></i> {{ site.email }}</a></li>
</ul>
</div>
<div class="map"><iframe title="Map of Dissent Cafe and Bar, 181 City Walk, Canberra" src="https://www.google.com/maps?q=Dissent+Cafe+and+Bar,+181+City+Walk,+Canberra+ACT+2601&z=17&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
</div>
</section>
