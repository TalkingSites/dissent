<section class="band {{ sectionBg }}" id="{{ sectionTitle | slugify }}">
<div class="container split{% if sectionLayout == 'left' %} split-left{% endif %}">
<div class="rich">
<h2>{{ sectionTitle }}</h2>
{{ sectionText | markdown | safe }}
{%- include "partials/sectionLink.njk" %}
</div>
{% if sectionImage %}<figure class="photo"><img src="{{ sectionImage }}" alt="{{ sectionAlt }}" loading="lazy"/></figure>{% endif %}
</div>
</section>
