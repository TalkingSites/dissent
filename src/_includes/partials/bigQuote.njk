<section class="band quote-band">
<div class="container">
<blockquote>
<p>{{ quoteText }}</p>
{% if quoteBy %}<footer>{% if quoteLink %}<a href="{{ quoteLink }}">{{ quoteBy }} <i class="bi bi-arrow-right" aria-hidden="true"></i></a>{% else %}{{ quoteBy }}{% endif %}</footer>{% endif %}
</blockquote>
</div>
</section>
